{
	"name": "auto-commit-cli",
	"version": "0.1.4",
	"description": "Automatically commit and push changes using AI-generated commit messages",
	"main": "main.js",
	"bin": {
		"auto-commit": "./main.js"
	},
	"scripts": {
		"start": "node main.js",
		"preview": "node main.js --preview",
		"commit": "node main.js",
		"commit-push": "node main.js --push"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.27.0"
	},
	"keywords": ["git", "commit", "ai", "cli"],
	"author": {
		"name": "Lukas Gisder-Dubé",
		"url": "https://dube.io",
		"twitter": "https://x.com/gisderdube"
	},
	"homepage": "https://github.com/gisderdube/auto-commit",
	"license": "MIT"
}
